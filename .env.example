# Backend
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LYRICVID_TEMP_ROOT=/tmp/lyricvid
MAX_AUDIO_BYTES=209715200
MAX_BACKGROUND_BYTES=20971520
JOB_TTL_SECONDS=1800
DOWNLOAD_TTL_SECONDS=600
CLEANUP_INTERVAL_SECONDS=60
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
HIDE_INTERNAL_ERRORS=false

# Whisper transcription
WHISPER_BACKEND=openai-whisper
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu

# Legacy WhisperX alignment CLI
HF_TOKEN=your_huggingface_token_here
ALIGNMENT_DEVICE=cpu


# Select your LLM provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic key — required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

ART_DIRECTION_MODEL=gpt-4o


LYRICVID_ASSET_DIRS=/path/to/backgrounds,/path/to/more/backgrounds

LYRICVID_SPEAKER_DIRS=/path/to/speaker_photos

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
